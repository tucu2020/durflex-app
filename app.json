{
  "expo": {
    "name": "Durflex",
    "slug": "durflex",
    "scheme": "durflex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEEF20"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.durflex.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Durflex usa Bluetooth para conectar el bastón RFID.",
        "NSBluetoothPeripheralUsageDescription": "Durflex usa Bluetooth para conectar el bastón RFID."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEEF20"
      },
      "package": "com.durflex.app",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "148c4ce9-beee-4f5f-abad-c38fcffc697f"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/148c4ce9-beee-4f5f-abad-c38fcffc697f"
    }
  }
}